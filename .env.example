# Copy this file to .env and fill in your real secrets.
# .env is git-ignored; never commit real credentials.

# --- Discord -----------------------------------------------------------
# Discord Developer Portal -> Bot -> Token
DISCORD_TOKEN=
# Your account id (used for the DM ping)
DISCORD_USER_ID=

# --- AI agent (optional, only for --ai-agent) ---------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=
